   }
  },
  {
   "id": 6,
   "title": "Version",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 21,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
